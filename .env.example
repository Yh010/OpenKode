OPENKODE_TELEMETRY_COLLECTOR_URL=https://openkode-collector.onrender.com/v1/telemetry/events
OPENKODE_SUPABASE_URL=https://hzrnpjibpbaxjmlbfkeh.supabase.co
# Optional override; the CLI includes OpenKode's public client key.
# For a custom Supabase URL, supply its publishable/anon key, never a privileged key.
OPENKODE_SUPABASE_PUBLISHABLE_KEY=
# Prefer `openkode configure` to save a provider/model and an encrypted API key.
# Optional environment overrides (never commit real keys):
# OPENKODE_PROVIDER=openai
# OPENKODE_MODEL=gpt-5.4-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Evaluation traces capture prompts, responses and tool payloads by default.
# Set false explicitly to record only structural metadata.
OPENKODE_TELEMETRY_CAPTURE_LLM_CONTENT=true
# Maximum combined character count for input message content and each LLM output.
OPENKODE_TELEMETRY_LLM_MAX_CONTENT_CHARS=4000
